{
  "name": "fiaa-evolution",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node --watch server/index.js",
    "start": "node server/index.js",
    "maintenance": "node server/maintenance-worker.js",
    "smoke": "node scripts/smoke-test.mjs",
    "test": "node --test",
    "test:server": "node --test test/server",
    "test:database": "sh scripts/test-database.sh",
    "test:database:local": "sh scripts/test-database-local.sh",
    "validate:data": "node scripts/validate-production-data.mjs",
    "validate:api": "ruby scripts/validate-openapi.rb",
    "validate": "npm run validate:data && npm run validate:api && npm test"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.4",
    "fastify": "5.12.5",
    "jose": "6.2.12",
    "pg": "8.23.0",
    "sanitize-html": "2.17.7",
    "zod": "4.6.5"
  }
}

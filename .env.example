NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://fiaa_app:change-me@127.0.0.1:5432/fiaa
# Uncomment all four settings together to enable staff administration.
# ADMIN_DATABASE_URL=postgresql://fiaa_admin_app:change-me@127.0.0.1:5432/fiaa
# ADMIN_OIDC_ISSUER=https://identity.example.com/
# ADMIN_OIDC_AUDIENCE=https://api.fiaaevolution.com/admin
# ADMIN_OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# Used only by scheduled maintenance and notification worker processes; inherits fiaa_worker.
# WORKER_DATABASE_URL=postgresql://fiaa_worker_app:change-me@127.0.0.1:5432/fiaa
DATABASE_SSL=false
COOKIE_SECRET=replace-with-at-least-32-random-characters
PUBLIC_WEB_ORIGIN=http://localhost:4173
PUBLIC_ASSET_BASE_URL=http://localhost:3000/assets
SERVE_STOREFRONT=true
# Keep false for local, review and staging environments. Enable only at approved launch.
PUBLIC_INDEXING=false
TRUST_PROXY=false
# Required when NODE_ENV=production. The matching approved adapter must be registered in the server runtime.
# PAYMENT_PROVIDER=approved-provider-id

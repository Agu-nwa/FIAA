# Copy this file to .env.ec2 on the EC2 instance. Never commit .env.ec2.
# Use http://PUBLIC_IP for IP-only staging, or https://staging.example.com after DNS is configured.
SITE_ADDRESS=:80
PUBLIC_WEB_ORIGIN=http://YOUR_EC2_PUBLIC_IP

# Generate independently on the server:
# openssl rand -base64 36
POSTGRES_PASSWORD=replace-with-a-long-random-password
COOKIE_SECRET=replace-with-at-least-32-random-characters
